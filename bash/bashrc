# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

# Created by `pipx` on 2026-11-06 15:00:17
export PATH="$PATH:/home/CharredLeviathan/.local/bin"

alias mpvs='mpv ~/music --shuffle --no-video'

alias ddgo='lynx duckduckgo.com'
wikip(){
	lynx https://en.wikipedia.org/wiki/$1
}

alias wscrshot='grim -g "$(slurp)" ~/temp.png'
alias xscrshot='maim --select | tee ~/temp.png | xclip -selection clipboard -target image/png'

alias updman='sudo pacman -Syu'
alias updfman='sudo pacman -Syyu'
alias rmaman='sudo pacman -Rns'
alias rmoman='sudo pacman -Rns $(pacman -Qtdq)' # give the error of no target specified if like there are no orphans which means that you don't have to do anything and is expected
alias lsaman='pacman -Q'
alias lseman='pacman -Qe'
alias lsuman='pacman -Qent'

alias gitstats='git log --oneline --stat --graph --decorate'
alias gitdcached='git diff --cached'

treesz(){
	tree $1 | tail -1
}
